+#  define ESP_MIPI_DSI_NC_ADDR(a) ((uintptr_t)CACHE_LL_L2MEM_NON_CACHE_ADDR(a))
+#else
+#  define ESP_MIPI_DSI_NC_ADDR(a) ((uintptr_t)(a))
+#endif
