+
+struct button_type_s
+{
+  bool is_touchpad;
+  union
+  {
+    int channel;
+    int gpio;
+  } input;
+};
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static const struct button_type_s g_buttons[] =
+{
+  {
+    .is_touchpad = false,
