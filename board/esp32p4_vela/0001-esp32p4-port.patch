+static int esp_wlan_sensitivity(struct netdev_lowerhalf_s *dev,
+                                struct iwreq *iwr, bool set)
+{
+  struct esp_wlan_priv_s *priv = (struct esp_wlan_priv_s *)dev;
+
+#ifdef ESP_WLAN_HAS_STA
+  if (priv->mode == IW_MODE_INFRA)
+    {
