config SYSTEM_V4L2CTL
	bool "v4l2ctl video device tool"
	default n
	depends on VIDEO_STREAM
	---help---
		Target-side replacement for the Linux v4l2-ctl tool.  NuttX does
		not ship v4l2-ctl, so the capture path is enumerated and exercised
		with this NSH command instead:

		  v4l2ctl list-devices
		  v4l2ctl -d /dev/video0 --info
		  v4l2ctl -d /dev/video0 --list-formats-ext
		  v4l2ctl -d /dev/video0 --capture 3

		It drives the standard V4L2 ioctls (QUERYCAP, ENUM_FMT,
		ENUM_FRAMESIZES, ENUM_FRAMEINTERVALS, S_FMT, REQBUFS, QBUF,
		STREAMON, DQBUF, STREAMOFF) with user-pointer buffers, and opens
		the device O_NONBLOCK so a sensor that never delivers a frame
		reports FAIL instead of blocking the shell.

if SYSTEM_V4L2CTL

config SYSTEM_V4L2CTL_PROGNAME
	string "v4l2ctl program name"
	default "v4l2ctl"

config SYSTEM_V4L2CTL_PRIORITY
	int "v4l2ctl task priority"
	default 100

config SYSTEM_V4L2CTL_STACKSIZE
	int "v4l2ctl stack size"
	default 4096

endif # SYSTEM_V4L2CTL
