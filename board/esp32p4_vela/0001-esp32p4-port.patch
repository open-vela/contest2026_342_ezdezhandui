+  .config = &g_esp_ana_cmpr1_config,
+  .ref_cfg = &ana_cmpr1_ref_cfg,
+  .debounce_config =
+  {
+    .wait_us = CONFIG_ESPRESSIF_ANA_COMPR1_DEBOUNCE * 1000,
