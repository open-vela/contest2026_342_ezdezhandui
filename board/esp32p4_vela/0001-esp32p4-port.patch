index 00000000000..938405dba39
--- /dev/null
+++ b/boards/risc-v/esp32p4/common/src/esp_board_i2s.c
@@ -0,0 +1,200 @@
+/****************************************************************************
+ * boards/risc-v/esp32p4/common/src/esp_board_i2s.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
