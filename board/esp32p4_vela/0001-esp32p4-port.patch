+  irqstate_t flags;
+
+  if (!priv->unit_used)
+    {
+      cperr("Invalid unit ID!\n");
+      return ERROR;
+    }
+
+  flags = spin_lock_irqsave(&priv->lock);
+  pcnt_ll_clear_count(ctx.dev, priv->unit_id);
+  priv->accum_value = 0;
+  spin_unlock_irqrestore(&priv->lock, flags);
+
+  return OK;
+}
