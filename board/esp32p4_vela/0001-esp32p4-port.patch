index 00000000000..90a69d3f53f
--- /dev/null
+++ b/boards/risc-v/esp32p4/common/src/esp_board_i2c.c
@@ -0,0 +1,172 @@
+/****************************************************************************
+ * boards/risc-v/esp32p4/common/src/esp_board_i2c.c
