+
+if(CONFIG_ESPRESSIF_I2C)
+  if(CONFIG_ESPRESSIF_I2C_PERIPH_MASTER_MODE)
+    list(APPEND SRCS esp_i2c.c)
+  endif()
+  if(CONFIG_ESPRESSIF_I2C_BITBANG)
