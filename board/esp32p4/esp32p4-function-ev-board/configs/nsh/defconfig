# DHCP: 让路由器同时下发 地址/网关/DNS。
#
# ⚠️ 两个符号缺一不可 —— 2026-09-14 真机踩到:
#   CONFIG_NETUTILS_DHCPC  只把 DHCP **客户端编进来**, 不会有人去调用它;
#   CONFIG_NETINIT_DHCPC   才是让 netinit 在开机时**真正跑** DHCP。
# 只开前者时, netinit 走 else 分支, 用 NuttX 出厂默认把网卡刷成
#   10.0.0.2/24  + 默认路由 10.0.0.1  (见 CONFIG_NETINIT_IPADDR/DRIPADDR)
# 而现场实际网段是 192.168.1.0/24 —— 于是 DNS 查询全部发往并不存在的
# 10.0.0.1, 30s 后超时; nslookup 报 "getaddrinfo failed: 1"
# (NuttX netdb.h: EAI_AGAIN=1, 即"超时"而非"域名不存在")。
# 同一原因也让主机侧够不到板子(不同网段), WebSocket 因此不可达。
#
# netinit.c:509  ifdef CONFIG_NETINIT_DHCPC -> addr=0, g_use_dhcpc=true
# netinit.c:660  if (g_use_dhcpc) netlib_obtain_ipv4addr()  -> 跑 DHCP
# netlib_obtainipv4addr.c:82  租约里的 dnsaddr -> netlib_set_ipv4dnsaddr()
# netlib_setipv4dnsaddr.c:73  -> dns_add_nameserver()  -> 解析器真正拿到 DNS
CONFIG_NETUTILS_DHCPC=y
CONFIG_NETUTILS_DHCPC_HOST_NAME="deskmate"
CONFIG_NETINIT_DHCPC=y

# ⚠️ 必须显式设置。不设时 configure 会落到 NuttX 的默认值 590
# (即 MTU 576), 而本板其余配置 (ethernet/webpanel/python) 都写 1514。
#
# 后果: MTU 576 下, 任何超过 576 字节的出站报文都要走 IP 分片。
# 之前网络本身不通(DNS 失败), ai_agent 从没真正发出去过流量, 所以没暴露;
# 2026-09-14 打通网络后, ai_agent 一启动 (~15s) 整块板子就冻死 ——
# 实测把 eth0 ifdown 掉再启动 ai_agent, 控制台 90s+ 一直正常, 说明冻结
# 由真实的出站流量触发。改成 1514 (MTU 1500) 与板内其他配置一致。
CONFIG_NET_ETH_PKTSIZE=1514

# ifup 只是"启动 PHY 状态机", 链路是异步协商好的。netinit 若不等于链路
# up 就发 DISCOVER, 第一个包会打进一条还没起来的链路并被静默丢弃 ——
# 表现为开机后 addr 停在 0.0.0.0, 手动 `ifconfig eth0 dhcp` 才拿到地址。
# 这里让它等 IFF_RUNNING (真 carrier, 只由 netdev_carrier_on 置位)。
CONFIG_NETINIT_DHCPC_LINK_WAIT_MS=5000

# 静态 DNS 仅作兜底(与现场网关一致); DHCP 拿到租约后会自动覆盖为
# 路由器下发的服务器。留成 10.0.0.1 会让解析器把"死地址"排在列表最前,
# 每次解析都先白等一轮超时。
CONFIG_ESP32P4_FUNCTION_EV_BOARD_DNS_PRIMARY="192.168.1.1"

