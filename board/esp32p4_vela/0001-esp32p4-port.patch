+                                   uint16_t header, FAR void *rx,
+                                   uint16_t rx_len);
+static lcd_color_format_t esp_mipi_dsi_map_format(uint8_t format);
+static int IRAM_ATTR esp_mipi_dsi_dma_isr(int irq, FAR void *context,
