+#  ifdef CONFIG_PM_GPIO_WAKEUP_TRIGGER_ANY_LOW
+  gpio_int_type_t level_mode = GPIO_INTR_LOW_LEVEL;
+#  else
+  gpio_int_type_t level_mode = GPIO_INTR_HIGH_LEVEL;
+#  endif /* CONFIG_PM_EXT1_WAKEUP */
