+  for (int i = 0; i < CONFIG_SOC_GPIO_PIN_COUNT; i++)
+    {
+      pin_mask = BIT64(i);
+      if ((mask_value & pin_mask) != 0)
+        {
+          gpio_wakeup_enable(i, level_mode);
+        }
+    }
+
+#ifdef CHECK_VDD_SPI
+  if ((mask_value & CHECK_VDD_SPI_PIN_MASKS) != 0)
+    {
+      esp_sleep_pd_config(ESP_PD_DOMAIN_VDDSDIO, ESP_PD_OPTION_ON);
+    }
+#endif /* CHECK_VDD_SPI */
