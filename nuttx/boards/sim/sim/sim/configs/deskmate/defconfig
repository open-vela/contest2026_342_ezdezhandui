#
# Simulated target configuration for the DeskMate control panel.
#
# This is a *headless* simulator configuration: it needs neither an X11
# display nor /dev/video0 on the host, so the UI and its logic can be built and
# driven on any Linux machine (CI included).
#
#   ./build.sh nuttx/boards/sim/sim/sim/configs/deskmate --cmake -j8
#
# The application renders into its own RGB565 frame buffer (the "mem" display
# backend), is driven by the script indev and writes snapshots through hostfs.
# See tools/test/sim_deskmate.sh for the one-command run.
#
# For an interactive window instead, build configs/lvgl_fb (needs an X11 host)
# and run `lvgldemo`, or flip EXAMPLES_DESKMATE_DISPLAY_FBDEV with VIDEO_FB.
#

CONFIG_ARCH="sim"
CONFIG_ARCH_BOARD="sim"
CONFIG_ARCH_BOARD_SIM=y
CONFIG_ARCH_CHIP="sim"
CONFIG_ARCH_SIM=y
CONFIG_BOARDCTL=y
CONFIG_BUILTIN=y
CONFIG_DEBUG_SYMBOLS=y
CONFIG_EXAMPLES_DESKMATE=y
CONFIG_EXAMPLES_DESKMATE_AGENT_MODE="mock"
CONFIG_EXAMPLES_DESKMATE_DISPLAY_MEM=y
CONFIG_EXAMPLES_DESKMATE_EXIT_AFTER=0
CONFIG_EXAMPLES_DESKMATE_HEIGHT=600
CONFIG_EXAMPLES_DESKMATE_HOSTFS_PATH=""
CONFIG_EXAMPLES_DESKMATE_PROGNAME="deskmate"
CONFIG_EXAMPLES_DESKMATE_STACKSIZE=65536
CONFIG_EXAMPLES_DESKMATE_WIDTH=1024
CONFIG_EXAMPLES_DESKMATE_WIFI_BSS="/host/wifi/bss"
CONFIG_FS_HOSTFS=y
CONFIG_GRAPHICS_LVGL=y
CONFIG_IDLETHREAD_STACKSIZE=4096
CONFIG_INIT_ENTRYPOINT="nsh_main"
# ---- networking: simulated ethernet (TAP) + simulated WiFi (wifi_sim) ----
CONFIG_NET=y
CONFIG_NET_IPv4=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_ICMP=y
CONFIG_NETDB_DNSCLIENT=y
CONFIG_LIBC_NETDB=y
CONFIG_NET_NETLINK=y
CONFIG_NETDEV_IFINDEX=y
# Wireless chain: the root is DRIVERS_WIRELESS, then the wireless ioctl/handler
# layer, then the pseudo WiFi driver wifi_sim.  Missing the root silently drops
# every symbol below it (no wlan0 at all).
CONFIG_DRIVERS_WIRELESS=y
CONFIG_DRIVERS_IEEE80211=y
CONFIG_NETDEV_WIRELESS_IOCTL=y
CONFIG_NETDEV_WIRELESS_HANDLER=y
CONFIG_DRIVERS_WIFI_SIM=y
CONFIG_WIFI_SIM_CONFDIR="/host/wifi"
CONFIG_SIM_NETDEV=y
CONFIG_SIM_WIFIDEV_NUMBER=1
CONFIG_SIM_WIFIDEV_PSEUDO=y
CONFIG_NETINIT_DHCPC=y
# CONFIG_LV_BUILD_EXAMPLES is not set
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_USE_NUTTX=y
CONFIG_NSH_BUILTIN_APPS=y
# Long command lines: the scripted runs pass absolute host paths to deskmate.
CONFIG_NSH_LINELEN=512
CONFIG_START_DAY=1
CONFIG_START_MONTH=11
CONFIG_START_YEAR=2026
CONFIG_SYSTEM_NSH=y
CONFIG_USEC_PER_TICK=1000
CONFIG_LV_USE_QRCODE=y
