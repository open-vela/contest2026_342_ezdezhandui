include common/Make.defs
include chip/espressif/Make.defs

# riscv_mtimer.c is added to CMN_CSRCS unconditionally by the baseline
# arch/risc-v/src/common/Make.defs, but it cannot compile while
# CONFIG_ONESHOT_COUNT is off (struct oneshot_operations_s has no clkcnt
# members).  P4 does not use the RISC-V mtimer oneshot lower half, so drop it
# here instead of editing the generic layer.  Same idiom as the riscv_vectors.S
# filter-out in arch/risc-v/src/esp32p4/espressif/Make.defs.
ifneq ($(CONFIG_ONESHOT_COUNT),y)
CMN_CSRCS := $(filter-out riscv_mtimer.c,$(CMN_CSRCS))
endif

CHIP_CSRCS += esp_chip_rev.c esp32p4_atomic.c

# P4-only SDIO / ESP-Hosted cluster, moved out of the shared espressif layer
# (plan 2026-11-01; see arch/risc-v/src/esp32p4/esp_hosted/).

ifeq ($(CONFIG_ESPRESSIF_SDMMC),y)
CHIP_CSRCS += esp_hosted/sdmmc/esp_sdmmc.c
endif

ifeq ($(CONFIG_ESPRESSIF_HOSTED_SDIO),y)
CHIP_CSRCS += esp_hosted/transport/esp_hosted_sdio.c
CHIP_CSRCS += esp_hosted/frame/src/eh_frame.c
endif

# P4-only drivers that belong to this port (moved out of the shared layer).
ifeq ($(CONFIG_ESP_RMT),y)
ifeq ($(CONFIG_DRIVERS_RC),y)
CHIP_CSRCS += drivers/esp_lirc.c
endif
endif

ifeq ($(CONFIG_SYSTEM_NXDIAG_ESPRESSIF_CHIP_WO_TOOL),y)
CHIP_CSRCS += drivers/esp_nxdiag.c
endif

ifeq ($(CONFIG_ESPRESSIF_ADC),y)
CHIP_CSRCS += drivers/esp_adc.c
endif

ifeq ($(CONFIG_ESPRESSIF_TOUCH),y)
CHIP_CSRCS += drivers/esp_touch.c
endif

ifeq ($(CONFIG_ESPRESSIF_MIPI_CSI),y)
CHIP_CSRCS += drivers/esp_csi.c
endif

ifeq ($(CONFIG_ESPRESSIF_DEDICATED_GPIO),y)
CHIP_CSRCS += drivers/esp_dedic_gpio.c
endif

ifeq ($(CONFIG_ESPRESSIF_MIPI_DSI),y)
CHIP_CSRCS += drivers/esp_mipi_dsi.c
endif

ifeq ($(CONFIG_ESPRESSIF_PPA),y)
CHIP_CSRCS += drivers/esp_ppa_scale.c
CHIP_CSRCS += drivers/esp_ppa_test.c
endif

ifeq ($(CONFIG_ESPRESSIF_EMAC),y)
CHIP_CSRCS += drivers/esp_emac.c
endif

ifeq ($(CONFIG_ESPRESSIF_I2S),y)
CHIP_CSRCS += drivers/esp_i2s.c
endif

INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)esp32p4$(DELIM)drivers
VPATH += drivers

INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)esp32p4$(DELIM)esp_hosted$(DELIM)sdmmc
INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)esp32p4$(DELIM)esp_hosted$(DELIM)transport
INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)esp32p4$(DELIM)esp_hosted$(DELIM)frame$(DELIM)include
INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)esp32p4$(DELIM)esp_hosted$(DELIM)frame$(DELIM)shim
INCLUDES += ${INCDIR_PREFIX}$(ARCH_SRCDIR)$(DELIM)esp32p4$(DELIM)esp_hosted$(DELIM)compat$(DELIM)platform_include
VPATH += esp_hosted$(DELIM)sdmmc esp_hosted$(DELIM)transport esp_hosted$(DELIM)frame$(DELIM)src

CFLAGS += ${DEFINE_PREFIX}_RETARGETABLE_LOCKING

# TODO: Remove these flags once ulp/lp_core/lp_core.c is updated.
CFLAGS += -Wno-array-bounds -Wno-stringop-overflow
