+
+if(CONFIG_ESPRESSIF_DEDICATED_GPIO)
+  list(APPEND SRCS esp_dedic_gpio.c)
+endif()
+
+if(CONFIG_ESPRESSIF_TEMP)
+  list(APPEND SRCS esp_temperature_sensor.c)
